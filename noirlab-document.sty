\edef\NOIRLabPackageDirectory{\currfiledir}

\RequirePackage[letterpaper,margin=1in,headheight=42pt,headsep=14pt,footskip=32pt]{geometry}
\RequirePackage[default]{sourcesanspro}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{etoolbox}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds}
\RequirePackage{hyperref}
\RequirePackage{bookmark}

\definecolor{NOIRLabBlue}{HTML}{0069A7}
\definecolor{NOIRLabGrey}{HTML}{6E6E72}
\definecolor{NOIRLabDarkGrey}{HTML}{3F424A}
\definecolor{NOIRLabLightBlue}{HTML}{CFE2F3}
\definecolor{NOIRLabRed}{HTML}{ED4C4C}
\definecolor{NOIRLabPurple}{HTML}{A260CD}
\definecolor{NOIRLabGold}{HTML}{FFB71B}
\definecolor{NOIRLabCyan}{HTML}{009ADE}
\definecolor{NOIRLabTeal}{HTML}{058B8C}
