\newcommand{\NOIRLabSemicircle}[1]{%
  \tikz[baseline=0pt]{%
    \fill[#1] (0,-0.10ex)
      arc[start angle=-90,end angle=90,radius=0.62ex] -- cycle;
  }%
}

\newcommand{\NOIRLabObservatoryList}{%
  \scriptsize\color{NOIRLabGrey}\raggedleft
  Cerro Tololo Inter-American Observatory\enspace\NOIRLabSemicircle{NOIRLabRed}\par
  Community Science and Data Center\enspace\NOIRLabSemicircle{NOIRLabPurple}\par
  Gemini Observatory\enspace\NOIRLabSemicircle{NOIRLabGold}\par
  Kitt Peak National Observatory\enspace\NOIRLabSemicircle{NOIRLabCyan}\par
  Vera C. Rubin Observatory\enspace\NOIRLabSemicircle{NOIRLabTeal}\par
}

\newcommand{\ConfigureNOIRLabPageStyle}{%
  \clearpairofpagestyles
  % \clearpairofpagestyles empties scrheadings and plain.scrheadings alike, and
  % KOMA puts chapter openings and the contents page on plain. The starred foot
  % commands refill both, so those pages keep their page number. The head is
  % deliberately left to scrheadings only, keeping opening pages uncluttered.
  \ihead{\NOIRLabHeaderMark\quad\NOIRLabDocumentShortTitle}
  \ohead{\scriptsize Version \NOIRLabVersion{} \textbullet{} \NOIRLabDistribution}
  \ifoot*{\scriptsize \NOIRLabFooterText}
  \cfoot*{\pagemark}
  \ofoot*{}
  \KOMAoptions{headsepline=0.4pt}
  \setkomafont{headsepline}{\color{NOIRLabGrey}}
  \pagestyle{scrheadings}
}

\newcommand{\NOIRLabControlNotice}{%
  \ifNOIRLabRelease
    This document is \NOIRLabStatus. It is effective as of \NOIRLabEffectiveDate. Changes require the applicable NOIRLab document-control process.
  \else
    This is a development preview, not a controlled release. It may be replaced during technical and editorial review.
  \fi
}

\newcommand{\MakeNOIRLabTitlePage}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \NOIRLabBrandBand
    \vspace*{12mm}

    \noindent
    \begin{minipage}[t][34mm][c]{0.38\textwidth}
      \raggedright
      \NOIRLabCoverMark
    \end{minipage}%
    \hfill
    \begin{minipage}[t][34mm][c]{0.56\textwidth}
      \NOIRLabObservatoryList
    \end{minipage}

    \vspace{25mm}

    \begin{center}
      {\color{NOIRLabBlue}\Huge\bfseries \NOIRLabDocumentTitle\par}
      \vspace{8mm}
      {\color{NOIRLabBlue}\LARGE \NOIRLabDocumentType\par}
      \vspace{9mm}
      {\large\bfseries Author: \NOIRLabAuthors\par}
      \ifdefempty{\NOIRLabReviewers}{}{%
        \vspace{2mm}{\normalsize Reviewers: \NOIRLabReviewers\par}%
      }
      \vspace{7mm}
      {\color{NOIRLabGrey}
        Version: \NOIRLabVersion\par
        Generated: \NOIRLabGenerationDate\par
        Distribution: \NOIRLabDistribution\par}
    \end{center}

    \vfill

    \noindent
    \begin{minipage}[b][20mm][c]{0.22\textwidth}
      \raggedright
      \AURACoverMark
    \end{minipage}%
    \hfill
    \begin{minipage}[b][20mm][c]{0.71\textwidth}
      \raggedright
      \footnotesize
      \ifNOIRLabRelease
        \NOIRLabControlNotice\par
        \medskip
      \fi
      \NOIRLabTitlePageNote\par
    \end{minipage}
  \end{titlepage}%
}
