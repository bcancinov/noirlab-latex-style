\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{noirlab-document}[2026/08/17 v0.2 Reusable NOIRLab document presentation]

% The package has two supported hosts. A KOMA-Script class (scrreprt, scrbook,
% scrartcl) receives the complete style. The standalone class receives the
% colors and TikZ vocabulary only, which is what the figure sources need.
% Any other class silently loses the heading, caption, and contents styling,
% so it is reported rather than left to be discovered in the PDF.
\@ifundefined{KOMAClassName}{%
  \@ifclassloaded{standalone}{}{%
    \PackageWarningNoLine{noirlab-document}{%
      No KOMA-Script class detected.\MessageBreak
      Heading, caption, contents, and page-mark styling are\MessageBreak
      disabled, and the 11pt body size is not enforced.\MessageBreak
      Use scrreprt, scrbook, or scrartcl for the complete style%
    }%
  }%
}{}

