\hypersetup{
  colorlinks=true,
  linkcolor=NOIRLabBlue,
  citecolor=NOIRLabBlue,
  urlcolor=NOIRLabBlue,
  pdfencoding=auto,
  psdextra
}

% Complete reusable document typography and spacing.
\linespread{1.07}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.68em plus 0.16em minus 0.10em}
\setlength{\parfillskip}{0pt plus 1fil}
\setlength{\textfloatsep}{18pt plus 4pt minus 3pt}
\setlength{\floatsep}{14pt plus 3pt minus 2pt}
\setlength{\intextsep}{14pt plus 3pt minus 2pt}
\renewcommand{\arraystretch}{1.18}
\setlist{nosep,leftmargin=*}
\setcounter{tocdepth}{2}

\ifcsname KOMAClassName\endcsname
  % The KOMA fontsize option is used instead of \changefontsizes so that the
  % body size resolves through scrsize11pt.clo. That keeps every derived size
  % integral; \changefontsizes scales them proportionally instead, which asks
  % for Computer Modern math at sizes it has no design for.
  \KOMAoptions{fontsize=11pt,numbers=noenddot}
  \setkomafont{disposition}{\sffamily\bfseries\color{NOIRLabBlue}}
  \setkomafont{section}{\sffamily\bfseries\color{NOIRLabBlue}\fontsize{14pt}{17pt}\selectfont}
  \setkomafont{subsection}{\sffamily\bfseries\color{NOIRLabGrey}\fontsize{11pt}{14pt}\selectfont}
  \setkomafont{caption}{\sffamily\small\color{NOIRLabGrey}}
  \setkomafont{captionlabel}{\sffamily\bfseries\small\color{NOIRLabBlue}}
  \setkomafont{partentry}{\sffamily\bfseries\color{NOIRLabBlue}}
  \setkomafont{pageheadfoot}{\sffamily\footnotesize\color{NOIRLabGrey}}
  % Chapter elements exist in scrreprt and scrbook but not in scrartcl.
  \ifcsname chapter\endcsname
    \setkomafont{chapter}{\sffamily\bfseries\color{NOIRLabBlue}\fontsize{18pt}{22pt}\selectfont}
    \setkomafont{chapterentry}{\sffamily\bfseries\color{NOIRLabDarkGrey}}
    \setkomafont{chapterentrypagenumber}{\sffamily\bfseries\color{NOIRLabBlue}}
  \fi
\fi

% Shared diagram vocabulary. Figures retain their content and geometry, while
% their colors, typography, blocks, and connection semantics come from here.
\tikzset{
  noirlab block/.style={
    draw=NOIRLabGrey,
    rounded corners=1.5pt,
    minimum height=9mm,
    minimum width=28mm,
    align=center,
    fill=white,
    font=\sffamily\small
  },
  noirlab main board/.style={noirlab block,draw=NOIRLabBlue,fill=NOIRLabLightBlue!40},
  noirlab function board/.style={noirlab block,draw=NOIRLabGrey,fill=NOIRLabGrey!8},
  noirlab backplane/.style={noirlab block,draw=NOIRLabBlue,very thick},
  noirlab card/.style={draw=NOIRLabGrey,rounded corners=2pt,minimum width=31mm,minimum height=38mm,align=center,fill=NOIRLabGrey!6,font=\sffamily\small},
  noirlab contact/.style={draw=NOIRLabGrey,fill=white,minimum width=17mm,minimum height=3mm,inner sep=0pt},
  noirlab health/.style={noirlab block,minimum width=34mm,font=\sffamily\footnotesize},
  noirlab band/.style={draw=NOIRLabGrey!55,rounded corners=2pt,fill=NOIRLabGrey!3,inner sep=4mm},
  noirlab power flow/.style={draw=NOIRLabAlertRed,thick,-{Latex[length=2mm]}},
  noirlab safety flow/.style={draw=black,very thick,dashed,-{Latex[length=2mm]}},
  noirlab timing flow/.style={draw=NOIRLabBlue,thick,-{Latex[length=2mm]}},
  noirlab data flow/.style={draw=NOIRLabGrey,thick,-{Latex[length=2mm]}}
}

