    \fill[NOIRLabBlue]
      ([yshift=-9mm]current page.north west) rectangle ([yshift=-11mm]current page.north east);
    \fill[NOIRLabRed]
      ([xshift=-100mm,yshift=-9mm]current page.north east) --
      ([xshift=-86mm,yshift=-9mm]current page.north east) --
      ([xshift=-91mm,yshift=-11mm]current page.north east) --
      ([xshift=-105mm,yshift=-11mm]current page.north east) -- cycle;
    \fill[NOIRLabPurple]
      ([xshift=-86mm,yshift=-9mm]current page.north east) --
      ([xshift=-72mm,yshift=-9mm]current page.north east) --
      ([xshift=-77mm,yshift=-11mm]current page.north east) --
      ([xshift=-91mm,yshift=-11mm]current page.north east) -- cycle;
    \fill[NOIRLabGold]
      ([xshift=-72mm,yshift=-9mm]current page.north east) --
      ([xshift=-58mm,yshift=-9mm]current page.north east) --
      ([xshift=-63mm,yshift=-11mm]current page.north east) --
      ([xshift=-77mm,yshift=-11mm]current page.north east) -- cycle;
    \fill[NOIRLabCyan]
